# CognoDB Graph Database Connection Details
# Replace with your instance connection URI, user (default: cognodb) and password.
COGNODB_URI=bolt+s://your-instance.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your-secure-password

# Optional Configuration
NEXT_PUBLIC_APP_NAME=CineGraph
NEXT_PUBLIC_ENABLE_FALLBACK=true
